# ============================================================
# .dockerignore — perkecil build context Docker (hemat bandwidth,
# build lebih cepat, image lebih ramping). Resource gratis.
# ============================================================

# Git & CI
.git
.github
.gitignore

# Python cache
__pycache__
*.py[cod]
*.so
.eggs
*.egg-info

# Environment & secrets (JANGAN pernah masuk image)
.env
.env.*
!.env.example

# Data runtime & log
bot.log
*.log
*.pkl
data/*.db
# CATATAN PENTING: JANGAN tambahkan baris `/data` di sini — pola itu
# mengecualikan PAKET PYTHON `data/` (market_data, cache, database, dll)
# dari image → bot crash saat start (ModuleNotFoundError: No module named
# 'data'). Direktori runtime /data dibuat Dockerfile (RUN mkdir -p /data)
# dan bukan bagian dari build context, jadi tidak perlu di-ignore.

# Virtual env
.venv
venv
env

# Test & dev (tidak dibutuhkan di production)
tests/

# IDE & OS
.idea
.vscode
*.swp
.DS_Store
Thumbs.db
