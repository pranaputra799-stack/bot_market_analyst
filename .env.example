# ===================== TELEGRAM =====================
# WAJIB: Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=123456789:AAYourBotTokenHere
BOT_USERNAME=marketai_analyst_bot
BOT_NAME=MarketAI Analyst

# ===================== AI PROVIDERS =====================
# Minimal 1-2 aja sudah cukup, OpenRouter recommended (PRIMARY)!

# OpenRouter API (PRIMARY - HANYA MODEL GRATIS): https://openrouter.ai/keys
# Bot otomatis memakai model free (:free / $0) dan auto-discover daftar model
# free terbaru dari API, jadi biaya AI tetap $0.
# PENTING: Agar semua model free bisa dipakai, set data policy di
# https://openrouter.ai/settings/privacy ke "Allow all".
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Groq API (Fallback 1): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API (Fallback 2): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cerebras API (Fallback 3): https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-your_cerebras_api_key_here

# Mistral AI (Fallback 4): https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Fallback order provider AI (pisahkan dengan koma). Default:
# openrouter -> groq -> gemini -> cerebras -> mistral
# (OpenRouter primary, HANYA model free)
# AI_FALLBACK_ORDER=openrouter,groq,gemini,cerebras,mistral

# ===================== AI ENGINE =====================
# Batas waktu total SATU permintaan AI (detik). Jika semua provider gagal
# beruntun, bot berhenti mencoba setelah budget ini habis agar user tidak
# menunggu terlalu lama saat semua provider sedang down.
AI_MAX_TOTAL_WAIT_SECONDS=60
# Timeout per request ke satu provider (detik)
AI_REQUEST_TIMEOUT=30
# Jeda minimum antar request ke provider AI yang sama (detik). 0 = pakai
# default per-provider. Naikkan (mis. 5) jika free tier sering 429 — tanpa
# perlu ubah kode.
AI_MIN_INTERVAL_SECONDS=0
# Batas token output default SATU panggilan AI (max_tokens). Default 2048 —
# hemat token: mencegah model bertele-tele/looping. Morning brief men-set 4096
# eksplisit. Turunkan (mis. 1024) jika ingin lebih hemat lagi.
AI_MAX_TOKENS_DEFAULT=2048
# Temperatur AI (kreativitas 0-1). Default 0.1 — cukup rendah agar analisis
# stabil & faktual (tidak mengarang angka). Naikkan jika ingin variasi jawaban.
# AI_TEMPERATURE=0.1
# (OpenRouter) Response caching (header X-OpenRouter-Cache): payload identik
# dikembalikan dari cache server dengan biaya $0 + latensi milidetik —
# melengkapi cache lokal bot untuk panggilan internal yang tidak di-cache di
# sisi bot. Set false jika tidak ingin respons disimpan di sisi OpenRouter.
# OPENROUTER_RESPONSE_CACHE=true

# ===================== DATA PROVIDERS =====================
# Data pasar & makro (semua gratis)
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# FRED (Federal Reserve): https://fred.stlouisfed.org/docs/api/api_key.html
# WAJIB untuk kalender ekonomi real-time (jadwal rilis NFP, CPI, PPI, GDP)
FRED_API_KEY=your_fred_api_key_here

# Finnhub: https://finnhub.io/register (untuk berita & sentimen; kalender ekonomi butuh plan berbayar)
FINNHUB_KEY=your_finnhub_key_here

# Marketaux: https://www.marketaux.com/
MARKETAUX_KEY=your_marketaux_key_here

# NewsAPI: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Exchange Rate API: https://www.exchangerate-api.com/
EXCHANGE_RATE_KEY=your_exchange_rate_key_here

# Twelve Data: https://twelvedata.com/apikey
TWELVEDATA_KEY=your_twelvedata_key_here

# ===================== OANDA (REAL-TIME FOREX & GOLD) =====================
# Sumber data REAL-TIME untuk Forex & Gold (XAU/USD). Tanpa ini, bot memakai
# Yahoo Finance (delayed 15-20 menit) seperti sebelumnya.
#
# Cara setup (gratis, ~2 menit):
# 1) Daftar akun DEMO: https://www.oanda.com/demo-account/
# 2) Generate API token: https://www.oanda.com/demo-account/tpa/personal_token
#    (login demo account -> Manage API Access)
# 3) Isi OANDA_API_KEY di bawah. OANDA_ACCOUNT_ID boleh dikosongkan — bot
#    otomatis mendeteksi akun demo pertama dari token.
#
# Pair yang didukung OANDA: EUR/USD, GBP/USD, USD/JPY, USD/CHF, AUD/USD,
# NZD/USD, USD/CAD, XAU/USD (Gold), XAG/USD (Silver). Instrumen lain
# (USD/IDR, DXY, index, crypto) tetap memakai Yahoo Finance.
OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# practice (demo, default) atau live
OANDA_ENV=practice
# TTL cache harga OANDA (detik) — lebih kecil = lebih realtime, lebih banyak request
OANDA_PRICE_TTL=30

# ===================== DATABASE (SUPABASE) =====================
# Opsional: supaya cache & memory percakapan tersimpan di database,
# bukan di RAM proses bot (justrunmy/Railway). Buat tabel sekali:
# jalankan migrations/supabase.sql di Supabase SQL Editor.
SUPABASE_URL=
SUPABASE_KEY=
# Aktifkan cache persisten (L2) di Supabase — set false untuk memory-only
SUPABASE_CACHE_ENABLED=true
# Batas entri di memory cache (entri terlama di-evict saat penuh)
CACHE_MAX_ENTRIES=5000

# ===================== CONVERSATION MEMORY =====================
# Budget TOKEN riwayat percakapan yang disuntikkan ke prompt LLM — dipotong
# presisi pakai tiktoken (fallback estimasi karakter bila tiktoken tidak ada).
# Pertukaran paling lama dibuang lebih dulu saat melebihi budget.
# MEMORY_MAX_TOKENS_IN_CONTEXT=600
# Lama riwayat percakapan per-user tersimpan (detik). Default 24 jam (86400);
# set 900 (15 menit) jika ingin konteks follow-up lebih pendek.
# MEMORY_TTL_SECONDS=86400
# Jumlah pertukaran (Q&A) yang DISIMPAN per user. Default 10 (rentang 2-30).
# MEMORY_MAX_ENTRIES=10
# Berapa pertukaran terakhir yang DIMASUKKAN ke prompt LLM. Default 6
# (tidak boleh melebihi MEMORY_MAX_ENTRIES).
# MEMORY_MAX_EXCHANGES_IN_CONTEXT=6

# ===================== MORNING BRIEF =====================
# Jam pengiriman morning brief otomatis (24h format)
MORNING_BRIEF_HOUR=7
MORNING_BRIEF_MINUTE=0
MORNING_BRIEF_TIMEZONE=Asia/Jakarta

# ===================== ECONOMIC EVENT ALERTS =====================
# Notifikasi otomatis event ekonomi high-impact (per-user via /alert on)
ECONOMIC_ALERT_ENABLED=true
# Jam digest harian event high-impact hari ini
ECONOMIC_ALERT_DIGEST_HOUR=7
ECONOMIC_ALERT_DIGEST_MINUTE=30
# Reminder dikirim X jam sebelum event rilis
ECONOMIC_ALERT_LEAD_HOURS=1
# Interval pengecekan reminder (menit)
ECONOMIC_ALERT_CHECK_INTERVAL_MINUTES=15

# ===================== EVENT AFTERMATH (ANALISIS SETELAH RILIS) =====================
# Notifikasi otomatis SETELAH event high-impact rilis: angka Actual vs Forecast +
# analisis AI dampaknya ke DXY (US Dollar Index), Gold, dan FX — dikirim ke
# subscriber /alert. Dedup persisten di Supabase (tabel event_reports).
EVENT_AFTERMATH_ENABLED=true
# Jendela jam ke belakang: event yang rilis dalam N jam terakhir akan dilaporkan
EVENT_AFTERMATH_LOOKBACK_HOURS=6
# Interval pengecekan aftermath (menit, default 30) — TERPISAH dari reminder (15 mnt).
# Aftermath tidak butuh ketepatan waktu, jadi lebih jarang = hemat FRED + AI
# di hari tanpa news. Diklem 10..120.
EVENT_AFTERMATH_CHECK_INTERVAL_MINUTES=30

# ===================== NEWS PREDICTION (XAU/USD) =====================
# Prediksi arah emas (naik/turun) untuk event ekonomi high-impact, dikirim ke
# subscriber /alert. Alur: T-5 menit prediksi → setelah rilis (T+15 menit) AI
# menilai benar/salah/flat → riwayat & win rate via /prediksi.
NEWS_PREDICTION_ENABLED=true
# Menit sebelum rilis saat prediksi dikirim ("5 menit sebelum news")
NEWS_PREDICTION_LEAD_MINUTES=5
# Menit setelah rilis sebelum hasil dievaluasi
NEWS_PREDICTION_SETTLE_MINUTES=15
# Interval pengecekan (menit) — kecil agar prediksi mendekati T-5 menit.
# Default 2 (dulu 1): prediksi tetap terkirim antara T-5 s.d. T-3 dengan
# lead 5 menit, tapi beban job konstan di free tier berkurang setengah.
NEWS_PREDICTION_CHECK_INTERVAL_MINUTES=2
# Ambang pergerakan harga (persen): di bawah ini dianggap "flat" (tidak jelas)
NEWS_PREDICTION_MIN_MOVE_PCT=0.05
# Maksimum prediksi dibuat/dievaluasi per run (batas anggaran AI)
NEWS_PREDICTION_MAX_PER_RUN=2

# Chat IDs yang menerima morning brief otomatis (pisahkan dengan koma)
# Dapatkan chat ID dari https://t.me/userinfobot
MORNING_BRIEF_CHAT_IDS=

# ===================== ERROR TRACKING (Opsional) =====================
# Sentry: https://sentry.io (gratis untuk pemakaian kecil)
# Kosongkan jika tidak ingin memakai error tracking.
SENTRY_DSN=

# ===================== BOT SETTINGS =====================
# User ID admin (untuk akses fitur khusus — /broadcast & /stats — pisahkan
# dengan koma). Cek ID via @userinfobot.
# Admin juga menerima NOTIFIKASI OTOMATIS (anti silent-fail): bot online,
# setup webhook gagal, tabel Supabase hilang, dan semua AI provider down.
# Kosongkan untuk menonaktifkan notifikasi admin.
ADMIN_USER_IDS=

# ===================== ANALYSIS ENGINE =====================
# Multi-Agent Analysis System (dari MarketLens BTC)
# Enable/disable multi-agent analysis pipeline
# Matikan jika ingin menggunakan legacy single-prompt mode
ENABLE_MULTI_AGENT=true

# ===================== WEBHOOK =====================
# Di Railway/Render: TERISI OTOMATIS. Tidak perlu diisi manual!
# Di JustRunMy: isi MANUAL sesuai URL publik dari panel (Add HTTPS port),
# contoh: WEBHOOK_URL=https://nama-app.justrunmy.app
# Di server sendiri: isi domain kamu
WEBHOOK_URL=
WEBHOOK_LISTEN=0.0.0.0
# Alias lama untuk PORT (biasanya diisi otomatis platform; JustRunMy manual)
# WEBHOOK_PORT=8080

# Mode menjalankan bot: auto (default) | webhook | polling
# - auto: webhook bila platform cloud terdeteksi ATAU WEBHOOK_URL terisi,
#   selain itu polling.
# - polling (REKOMENDASI JustRunMy): jalan tanpa port publik/URL sama sekali,
#   cukup TELEGRAM_BOT_TOKEN. Telegram menghubungi bot, bukan sebaliknya.
# - webhook (JustRunMy): butuh HTTPS port di panel + WEBHOOK_URL + PORT
#   sesuai mapping (mis. PORT=8080) + BOT_RUN_MODE=webhook.
# BOT_RUN_MODE=auto

# Secret token untuk keamanan webhook (opsional).
# Default: diturunkan otomatis dari sha256 TELEGRAM_BOT_TOKEN (hex — dijamin
# valid). Kalau diisi manual, HANYA karakter A-Z, a-z, 0-9, _ dan - yang
# diizinkan Telegram; karakter lain akan dibuang otomatis oleh kode.
# WEBHOOK_SECRET=

# ===================== HEALTH ENDPOINT =====================
# Endpoint HTTP /health (aiohttp, port terpisah) untuk uptime monitoring /
# Docker healthcheck. Berjalan di daemon thread — tidak mengganggu webhook
# Telegram. Conto pemeriksaan: curl http://127.0.0.1:8090/health
HEALTH_ENDPOINT_ENABLED=true
# Port /health — HARUS berbeda dari PORT webhook. Default 8090.
HEALTH_PORT=8090
# Bind address /health. Default 127.0.0.1 (localhost) — cukup untuk Docker
# healthcheck & probe lokal. Ubah ke 0.0.0.0 hanya jika butuh probe remote.
# HEALTH_BIND=127.0.0.1

# ===================== CRYPTO REAL-TIME (ccxt) =====================
# Harga & candle BTC/ETH diambil REAL-TIME dari exchange publik (Binance,
# Coinbase, Kraken, OKX, Bybit, KuCoin) via ccxt — TANPA API key. Yahoo
# Finance utk crypto delayed 15-20 menit. Analisis teknikal BTC/ETH ikut
# memakai candle real-time ccxt. TTL cache pendek (detik);
# lebih kecil = lebih realtime, lebih banyak request ke exchange.
# CCXT_PRICE_TTL=30
# CCXT_OHLCV_TTL=60

# ===================== LOGGING =====================
LOG_LEVEL=INFO
LOG_FILE=bot.log
# Tulis log ke file (LOG_FILE) selain stdout. Default nonaktif — log cukup ke
# stdout (ditangkap panel platform). Aktifkan bila butuh file lokal.
# LOG_TO_FILE=1

# ===================== RAILWAY (REFERENSI) =====================
# Semua var di bawah ini DIISI OTOMATIS oleh Railway saat deploy.
# Tidak perlu di-set manual! Hanya untuk referensi.
# RAILWAY_SERVICE_ID=
# RAILWAY_PUBLIC_DOMAIN=myproject.up.railway.app
# RAILWAY_ENVIRONMENT=production
# PORT=8080
